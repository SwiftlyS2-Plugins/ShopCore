<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<OutputPath>$(ProjectDir)..\build\plugins\ShopCore\</OutputPath>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
	</PropertyGroup>

  <ItemGroup>
    <!-- No direct Microsoft.Extensions.* references: SwiftlyS2.CS2 brings them at the version SwiftlyS2
         itself builds against, and pinning them here fails restore (NU1605) whenever the SDK raises them. -->
    <PackageReference Include="SwiftlyS2.CS2" Version="1.5.0" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="FreeSql" Version="3.5.100" />
    <PackageReference Include="FreeSql.Provider.Sqlite" Version="3.5.100" />
    <PackageReference Include="FreeSql.Provider.MySql" Version="3.5.100"/>
    <PackageReference Include="FreeSql.Provider.MySqlConnector" Version="3.5.100" />
  </ItemGroup>

  <ItemGroup>
		<ProjectReference Include="..\ShopCore.Contract\ShopCore.Contract.csproj" />
	</ItemGroup>

  <ItemGroup>
    <Reference Include="Cookies.Contract">
      <HintPath>libs\Cookies.Contract.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Economy.Contract">
      <HintPath>libs\Economy.Contract.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="resources/translations/**/*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="resources/templates/**/*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
